{
  "name": "c-cpp-preprocessors-visualizer",
  "displayName": "C/C++ Preprocessors Visualizer",
  "description": "Intuitive visual cues for macro and preprocessor directives",
  "version": "0.1.2",
  "engines": {
    "vscode": "^1.87.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onCommand:c-cpp-preprocessors-visualizer.enable",
    "onLanguage:c",
    "onLanguage:cpp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "c-cpp-preprocessors-visualizer",
      "properties": {
        "c-cpp-preprocessors-visualizer.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable this extension"
        },
        "c-cpp-preprocessors-visualizer.hints.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable hints"
        },
        "c-cpp-preprocessors-visualizer.outlines.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable outlines"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.87.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "@vscode/test-cli": "^0.0.6",
    "@vscode/test-electron": "^2.3.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BastienJbn/c-cpp-preprocessors-visualizer.git"
  },
  "publisher": "bjubineau"
}
